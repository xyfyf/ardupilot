# 轨迹/路径规划参数：以下为植保作业的**行业典型值**，作为仿真建模的占位设定，
# 等拿到实机作业规划参数后替换（见 flight-test/数据需求清单 第 6.1 节）。
#   WPNAV_SPEED 450   作业速度 4.5 m/s（常用 3-6）
#   WPNAV_ACCEL 300   水平加速度 3.0 m/s²，须 ≤ g·tan(PSC_ANGLE_MAX)=3.57
#   WPNAV_JERK    4   加加速度 4 m/s³
#   LOIT_SPEED  600   手动飞行速度上限 6 m/s
#   PSC_ANGLE_MAX 20  AUTO/GUIDED 的倾角上限（AC_PosControl 直接用它）
#   ANGLE_MAX  2000   20°，LOITER 另受 LOIT_ANG_MAX 约束
# EFT 植保六旋翼问题复现场景参数。
# 控制参数来自 00000231；着陆参数来自 00000219/220/231。

FRAME_CLASS          2
FRAME_TYPE           13

MOT_PWM_MIN          1050
MOT_PWM_MAX          1950
MOT_SPIN_MIN         0.10
MOT_SPIN_MAX         0.95
MOT_THST_EXPO        0.65
MOT_THST_HOVER       0.161
MOT_BAT_VOLT_MIN     42.0
MOT_BAT_VOLT_MAX     50.4

ATC_RAT_RLL_P        0.16
ATC_RAT_RLL_I        0.12
ATC_RAT_RLL_D        0.015
ATC_RAT_RLL_FF       0.0
ATC_RAT_RLL_IMAX     0.20
ATC_RAT_PIT_P        0.16
ATC_RAT_PIT_I        0.12
ATC_RAT_PIT_D        0.015
ATC_RAT_PIT_FF       0.0
ATC_RAT_PIT_IMAX     0.20

ANGLE_MAX            2000
PSC_ANGLE_MAX        20
LOIT_ANG_MAX         15
LOIT_SPEED           600
LOIT_ACC_MAX         263
LOIT_BRK_ACCEL       150
LOIT_BRK_JERK        300

WPNAV_SPEED          450
WPNAV_ACCEL          300
WPNAV_JERK           4
WPNAV_SPEED_DN       200
LAND_ALT_LOW         500
LAND_SPEED           50
LAND_SPEED_HIGH      0

ARMING_CHECK         0
DISARM_DELAY         10
AUTO_OPTIONS         3
FS_THR_ENABLE        0
SCR_ENABLE           0
DID_ENABLE           0
AHRS_ORIENTATION     0
AHRS_TRIM_X          0
AHRS_TRIM_Y          0
EK3_SRC1_YAW         1

# ATTITUDE_FAST + 当前固件原有记录位；供换向瞬态离线分析。
LOG_BITMASK          145375
LOG_DISARMED         0
LOG_REPLAY           0
