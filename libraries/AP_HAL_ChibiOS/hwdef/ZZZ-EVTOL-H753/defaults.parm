# ZZZ-EVTOL-H753 ArduPilot defaults for fixed-wing / VTOL (tune per airframe)

COMPASS_ENABLE,1
COMPASS_AUTODEC,1

# NeoPixel on PWM13
SERVO13_FUNCTION,120
NTF_LED_TYPES,455

SERIAL1_PROTOCOL,2
SERIAL1_BAUD,115
SERIAL2_PROTOCOL,5
SERIAL3_PROTOCOL,42
SERIAL4_PROTOCOL,5
SERIAL6_PROTOCOL,23
SERIAL7_PROTOCOL,2
SERIAL7_BAUD,115
SERIAL8_PROTOCOL,-1

# VTX 9V power - PINIO1 / RELAY2 GPIO 81
RELAY2_FUNCTION,1
RELAY2_PIN,81

# Camera switch - PINIO2 / RELAY3 GPIO 82
RELAY3_FUNCTION,1
RELAY3_PIN,82

# External PDB enable - PINIO3 / RELAY4 GPIO 83
RELAY4_FUNCTION,1
RELAY4_PIN,83

# Dual CAN: CAN1=PDB/主设备, CAN2=扩展（电调/RTK 等）
CAN_P1_DRIVER,1
CAN_P2_DRIVER,1
