# ZZZ EVTOL-H743 bootloader (UART7 + USB, same family as ZZZ-EVTOL-H753)

MCU STM32H7xx STM32H743xx

APJ_BOARD_ID AP_HW_ZZZ-EVTOL-H743

OSCILLATOR_HZ 8000000

FLASH_SIZE_KB 2048

FLASH_RESERVE_START_KB 0

FLASH_BOOTLOADER_LOAD_KB 128

SERIAL_ORDER OTG1 UART7

PE7 UART7_RX UART7 NODMA
PE8 UART7_TX UART7 NODMA

PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

PD10 VTX_PWR OUTPUT LOW
PE2  PDB_EN OUTPUT LOW

PE3 LED_BOOTLOADER OUTPUT LOW
define HAL_LED_ON 0

PC15 BMI088_G_CS CS
PC13 BMI088_A_CS CS
PB12 MAX7456_CS CS
PC14 BMI270_CS CS
