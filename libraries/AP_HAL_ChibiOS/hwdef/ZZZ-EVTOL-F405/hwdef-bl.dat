# ZZZ EVTOL-F405 bootloader

MCU STM32F4xx STM32F405xx

APJ_BOARD_ID AP_HW_ZZZ-EVTOL-F405

OSCILLATOR_HZ 8000000

FLASH_SIZE_KB 1024

FLASH_RESERVE_START_KB 0

FLASH_BOOTLOADER_LOAD_KB 64

PC7 LED_BOOTLOADER OUTPUT LOW GPIO(0)
PC6 LED_ACTIVITY OUTPUT LOW GPIO(1)
define HAL_LED_ON 0

SERIAL_ORDER OTG1

PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

PA4  BMI270_CS CS
PB12 OSD_CS CS
PC14 FLASH_CS CS
