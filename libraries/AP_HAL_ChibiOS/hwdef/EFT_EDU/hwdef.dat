# hw definition file for processing by chibios_hwdef.py

# default to all pins low to avoid ESD issues (must be before MCU)
DEFAULTGPIO OUTPUT LOW PULLDOWN

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID AP_HW_EFT_EDU

# unlock motors immediately after arming (no ARMING_DELAY_SEC wait)
define ARMING_DELAY_SEC 0

# Crystal is 16MHz
OSCILLATOR_HZ 16000000
STM32_ST_USE_TIMER 5

# Flash size 2MB
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 128
STORAGE_FLASH_PAGE 14

USB_STRING_MANUFACTURER "EFT_FC_T"
USB_STRING_PRODUCT "EFT_FC_T"

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# Debug / SWD
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

STDOUT_SERIAL SD1
STDOUT_BAUDRATE 57600

# IMU: ICM42670 on SPI2
PD3  SPI2_SCK      SPI2
PB14 SPI2_MISO     SPI2
PC1  SPI2_MOSI     SPI2
PE12 ICM42670_CS   CS

# I2C Configuration
PB8 I2C1_SCL I2C1
PB9 I2C1_SDA I2C1
PB6 I2C4_SCL I2C4
PB7 I2C4_SDA I2C4
I2C_ORDER I2C1 I2C4

# I2C1: Compass (QMC5883P); Baro optional (board may ship without SPL06)
COMPASS QMC5883P I2C:0:0x2C false ROTATION_NONE
BARO SPL06 I2C:0:0x77

# I2C4 (external): IST8310 compass (0x0F); INA238 power module (0x40, shunt 0.5mOhm)
COMPASS IST8310 I2C:1:0x0F true ROTATION_NONE
define HAL_BATT_MONITOR_DEFAULT 21
define HAL_BATTMON_INA2XX_BUS 1
define HAL_BATTMON_INA2XX_ADDR 0x40
define DEFAULT_BATTMON_INA2XX_SHUNT 0.0005
define DEFAULT_BATTMON_INA2XX_MAX_AMPS 90.0

# CAN1
PD0 CAN1_RX CAN1
PD1 CAN1_TX CAN1

# Serial Order
# SERIAL0: USB
# SERIAL1: USART1 (GPS1)
# SERIAL2: UART4 (RSV2)
# SERIAL3: USART2 (RSV1)
# SERIAL4: USART3 (REMOTEID)
# SERIAL5: UART5 (ELRS)
# SERIAL6: UART8 (LINK)
# SERIAL7: UART7 (RTK)
SERIAL_ORDER OTG1 USART1 UART4 USART2 USART3 UART5 UART8 UART7

# GPS1 connector
PA9  USART1_TX USART1
PA10 USART1_RX USART1

# Telem1 (RSV1)
PA2 USART2_TX USART2 NODMA
PA3 USART2_RX USART2 NODMA

# Telem2 (RSV2)
PA0 UART4_TX UART4 NODMA
PA1 UART4_RX UART4 NODMA

# RemoteID
PD8 USART3_TX USART3 NODMA
PD9 USART3_RX USART3 NODMA

# ELRS
PB13 UART5_TX UART5 NODMA
PB12 UART5_RX UART5 NODMA

# LINK
PE1 UART8_TX UART8 NODMA
PE0 UART8_RX UART8 NODMA

# MAVLink2 STX 0xEF on USB (SERIAL0/Type-C) and LINK telemetry (SERIAL6/UART8) only
define HAL_MAVLINK_EF_MAGIC_SERIAL_MASK ((1<<0)|(1<<6))

# RTK (UM982 main GPS)
PE8 UART7_TX UART7 NODMA
PE7 UART7_RX UART7 NODMA

# SD Card
PC8  SDMMC1_D0  SDMMC1
PC9  SDMMC1_D1  SDMMC1
PC10 SDMMC1_D2  SDMMC1
PC11 SDMMC1_D3  SDMMC1
PC12 SDMMC1_CK  SDMMC1
PD2  SDMMC1_CMD SDMMC1

# Enable FAT filesystem for SD card support
define FATFS_HAL_DEVICE SDCD1
define HAL_OS_FATFS_IO 1

# PWM Output
# Output PWM1-PWM6 at 1000us/400Hz immediately after timer start.
define HAL_EARLY_PWM_1000_MASK 0x3F
define HAL_EARLY_PWM_FREQ_HZ 400

# Main (D1-D8) — PULLDOWN until early PWM / RCOutput drives AF
PA8  TIM1_CH1 TIM1 PWM(1)  GPIO(50) PULLDOWN
PB11 TIM2_CH4 TIM2 PWM(2)  GPIO(51) PULLDOWN
PB10 TIM2_CH3 TIM2 PWM(3)  GPIO(52) PULLDOWN
PE14 TIM1_CH4 TIM1 PWM(4)  GPIO(53) PULLDOWN
PE13 TIM1_CH3 TIM1 PWM(5)  GPIO(54) PULLDOWN
PE11 TIM1_CH2 TIM1 PWM(6)  GPIO(55) PULLDOWN
PB1  TIM3_CH4 TIM3 PWM(7)  GPIO(56) PULLDOWN
PB0  TIM3_CH3 TIM3 PWM(8)  GPIO(57) PULLDOWN

# Aux (AUX1-AUX4)
PB4  TIM3_CH1 TIM3 PWM(9)  GPIO(58) PULLDOWN
PB3  TIM2_CH2 TIM2 PWM(10) GPIO(59) PULLDOWN
PD15 TIM4_CH4 TIM4 PWM(11) GPIO(60) PULLDOWN
PD14 TIM4_CH3 TIM4 PWM(12) GPIO(61) PULLDOWN

# RGB LED
PE6 LED_RED OUTPUT GPIO(90)
PE5 LED_GREEN OUTPUT GPIO(91)
PC5 LED_BLUE OUTPUT GPIO(92)
define AP_NOTIFY_GPIO_LED_RGB_RED_PIN 90
define AP_NOTIFY_GPIO_LED_RGB_GREEN_PIN 91
define AP_NOTIFY_GPIO_LED_RGB_BLUE_PIN 92
define HAL_GPIO_LED_ON 1
define AP_NOTIFY_GPIO_LED_RGB_ENABLED 1

# WS2812B
PC6 TIM8_CH1 TIM8 PWM(13) GPIO(62)

# ADC (Battery)
PC0 BATT_VOLTAGE_SENS ADC1 SCALE(1)

# SPI Devices
SPIDEV icm42670 SPI2 DEVID1 ICM42670_CS MODE3 2*MHZ 8*MHZ

# Sensors
IMU Invensensev3 SPI:icm42670 ROTATION_YAW_180

# Enable OpenDroneID (Remote ID) support for drone identification and tracking
define AP_OPENDRONEID_ENABLED 1

# enable DFU reboot for installing bootloader
ENABLE_DFU_BOOT 1

# Enable FrSky SPort support
define AP_FRSKY_TELEM_ENABLED 1
define AP_FRSKY_SPORT_TELEM_ENABLED 1
define AP_FRSKY_SPORT_PASSTHROUGH_ENABLED 1

# Flash storage size
define HAL_STORAGE_SIZE 32768

DMA_NOSHARE SPI2* USART1*