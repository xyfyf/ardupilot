# EFT_CAAC Default Parameters
# Aligned with x6100定版PID参数.param

# Serial mapping:
# SERIAL0 = USB
# SERIAL1 = USART1 (GPS1 connector)
# SERIAL2 = UART4  (RSV2)
# SERIAL3 = USART2 (RSV1)
# SERIAL4 = USART3 (REMOTEID)
# SERIAL5 = UART5  (ELRS RC)
# SERIAL6 = UART8  (LINK)
# SERIAL7 = UART7  (UM982 RTK GPS)

SERIAL0_PROTOCOL 2
SERIAL0_BAUD 115

SERIAL1_PROTOCOL 2
SERIAL1_BAUD 57
SERIAL1_OPTIONS 0

SERIAL2_PROTOCOL 2
SERIAL2_BAUD 115
SERIAL2_OPTIONS 0

SERIAL3_PROTOCOL 5
SERIAL3_BAUD 460
SERIAL3_OPTIONS 0

SERIAL4_PROTOCOL 2
SERIAL4_BAUD 57
SERIAL4_OPTIONS 0

SERIAL5_PROTOCOL 23
SERIAL5_BAUD 57
SERIAL5_OPTIONS 0

SERIAL6_PROTOCOL 2
SERIAL6_BAUD 57
SERIAL6_OPTIONS 0

SERIAL7_PROTOCOL 5
SERIAL7_BAUD 230
SERIAL7_OPTIONS 0

SERIAL_PASS1 0
SERIAL_PASS2 -1
SERIAL_PASSTIMO 15

# MAVLink streams (primary telem on SERIAL4 / MAV4 per param file)
MAV1_EXT_STAT 2
MAV1_EXTRA1 4
MAV1_EXTRA2 4
MAV1_EXTRA3 2
MAV1_OPTIONS 0
MAV1_PARAMS 0
MAV1_POSITION 2
MAV1_RAW_CTRL 0
MAV1_RAW_SENS 2
MAV1_RC_CHAN 2

MAV4_EXT_STAT 2
MAV4_EXTRA1 4
MAV4_EXTRA2 4
MAV4_EXTRA3 2
MAV4_OPTIONS 0
MAV4_PARAMS 0
MAV4_POSITION 2
MAV4_RAW_CTRL 0
MAV4_RAW_SENS 2
MAV4_RC_CHAN 2

# Battery (12S LiPo, voltage-only on this board)
BATT_MONITOR 3
BATT_ARM_VOLT 0
BATT_LOW_VOLT 44.4
BATT_CRT_VOLT 43.2
BATT_CAPACITY 22000
BATT_VOLT_MULT 31
BATT_AMP_PERVLT 17
BATT_LOW_TIMER 10

# AHRS / EKF
AHRS_EKF_TYPE 3
AHRS_ORIENTATION 4
EK3_SRC_OPTIONS 1
EK3_SRC1_POSXY 3
EK3_SRC1_POSZ 3
EK3_SRC1_VELXY 3
EK3_SRC1_VELZ 3
EK3_SRC1_YAW 2
EK3_IMU_MASK 3
EK3_MAG_CAL 3
EK3_GPS_CHECK 31

# GPS: DroneCAN primary + UM982 dual-antenna on SERIAL7
GPS1_TYPE 1
GPS1_RATE_MS 200
GPS1_MB_TYPE 0
GPS1_CAN_NODEID 0
GPS1_CAN_OVRIDE 0
GPS1_COM_PORT 1
GPS1_DELAY_MS 0
GPS1_GNSS_MODE 0

GPS2_TYPE 25
GPS2_MB_TYPE 1
GPS2_MB_OFS_X 0
GPS2_MB_OFS_Y -0.7
GPS2_MB_OFS_Z 0
GPS2_RATE_MS 200
GPS2_DELAY_MS 0
GPS2_GNSS_MODE 0
GPS2_CAN_NODEID 0
GPS2_CAN_OVRIDE 0
GPS2_COM_PORT 1

GPS_PRIMARY 1
GPS_AUTO_CONFIG 0
GPS_AUTO_SWITCH 4
GPS_BLEND_MASK 0
GPS_SAVE_CFG 0
GPS_DRV_OPTIONS 0
GPS_HDOP_GOOD 200
GPS_INJECT_TO 127
GPS_MIN_ELEV -100
GPS_NAVFILTER 8
GPS_RAW_DATA 0
GPS_SBAS_MODE 2

# Compass
COMPASS_LEARN 2
COMPASS_CAL_FIT 32
COMPASS_OFFS_MAX 1800
COMPASS_AUTO_ROT 2
COMPASS_USE 0
COMPASS_USE2 1
COMPASS_USE3 0

# CAN (CAN1: radar, CAN2: motor per hwdef — DroneCAN 1 Mbps)
CAN_P1_DRIVER 1
CAN_P1_BITRATE 1000000
