# EFT_CAAC 默认参数
# 串口映射 (对应板载丝印):
# SERIAL1 = RSV1
# SERIAL2 = RSV2
# SERIAL3 = GPS1
# SERIAL4 = LINK
# SERIAL5 = SBUS/RC
# SERIAL6 = REMOTEID (UART8)
# SERIAL7 = RTK (UART7, 用于 UM982)

# ========== 串口配置 (功能与波特率) ==========
# SERIAL1 (RSV1) - MAVLink2
SERIAL1_PROTOCOL 2
SERIAL1_BAUD 57

# SERIAL2 (RSV2) - MAVLink2
SERIAL2_PROTOCOL 2
SERIAL2_BAUD 57

# SERIAL3 (GPS1) - 禁用
SERIAL3_PROTOCOL 1
SERIAL3_BAUD 115

# SERIAL4 (LINK) - MAVLink2
SERIAL4_PROTOCOL 2
SERIAL4_BAUD 57

# SERIAL5 (SBUS/RC) - RCIN (用于接收ELRS)
SERIAL5_PROTOCOL 23
SERIAL5_BAUD 57

# SERIAL6 (REMOTEID) - MAVLink2 (用于给RID模块发数据)
SERIAL6_PROTOCOL 2
SERIAL6_BAUD 57

# SERIAL7 (RTK) - GPS
SERIAL7_PROTOCOL 5
SERIAL7_BAUD 230

# ========== 电池配置 ==========
BATT_ARM_VOLT 43
BATT_CAPACITY 20000

# ========== OpenDroneID (Remote ID) ==========
DID_ENABLE 0
DID_OPTIONS 0
DID_MAVPORT 6
DID_CANDRIVER 0

# ========== AHRS / EKF ==========
AHRS_EKF_TYPE 3
EK3_SRC1_YAW 3
INS_ACCEL_FILTER 20
INS_GYRO_FILTER 20

# ========== GPS (双天线定向配置) ==========
# 禁用 GPS1
GPS1_TYPE 0
# 启用 GPS2 作为双天线 RTK (UM982)
GPS2_TYPE 25
GPS2_MB_TYPE 1
GPS2_MB_OFS_Y 0.3
GPS_PRIMARY 0
GPS_AUTO_CONFIG 0
GPS_AUTO_SWITCH 1
GPS_BLEND_MASK 5
GPS_SAVE_CFG 0

# ========== 机架类型 (Hexa) ==========
FRAME_CLASS 2
FRAME_TYPE 13

# ========== 飞行模式与返航 ==========
FLTMODE1 2
FLTMODE2 2
FLTMODE3 2
FLTMODE4 16
FLTMODE5 16
FLTMODE6 16
RTL_ALT 3000

# ========== 电机输出配置 (Motor 1 ~ Motor 6) ==========
SERVO1_FUNCTION 33
SERVO2_FUNCTION 34
SERVO3_FUNCTION 35
SERVO4_FUNCTION 36
SERVO5_FUNCTION 37
SERVO6_FUNCTION 38
SERVO13_FUNCTION 120

# ========== 电机与油门调参 ==========
MOT_SPIN_ARM 0.1
MOT_SPIN_MIN 0.15
MOT_SPIN_MAX 0.95

# ========== CAN 总线 (启用 CAN1 和 DroneCAN) ==========
CAN_P1_DRIVER 1
CAN_D1_PROTOCOL 1
CAN_SLCAN_CPORT 1
CAN_SLCAN_TIMOUT 2

# ========== 避障与测距仪 ==========
PRX1_TYPE 4
RNGFND1_TYPE 34
AVOID_ENABLE 7
AVOID_MARGIN 3
AVOID_BEHAVE 1

# ========== LED 与蜂鸣器配置 ==========
NTF_LED_TYPES 257
NTF_LED_BRIGHT 3
NTF_LED_LEN 1
NTF_BUZZ_ON_LVL 1
NTF_BUZZ_TYPES 5

# ========== ELRS / RC 接收机配置 ==========
RC_PROTOCOLS 1
RC_OPTIONS 32
RSSI_TYPE 0

# ========== PID 控制参数 ==========
# --- ATC 姿态角速度 PID (Pitch / Roll / Yaw) ---
ATC_RAT_PIT_P 0.175
ATC_RAT_PIT_I 0.24177
ATC_RAT_PIT_D 0.025
ATC_RAT_PIT_IMAX 0.5
ATC_RAT_PIT_FLTD 13
ATC_RAT_PIT_FLTT 13

ATC_RAT_RLL_P 0.175
ATC_RAT_RLL_I 0.24177
ATC_RAT_RLL_D 0.025
ATC_RAT_RLL_IMAX 0.5
ATC_RAT_RLL_FLTD 13
ATC_RAT_RLL_FLTT 13

ATC_RAT_YAW_P 0.3
ATC_RAT_YAW_I 0.018
ATC_RAT_YAW_D 0.02
ATC_RAT_YAW_IMAX 0.5
ATC_RAT_YAW_FLTE 2
ATC_RAT_YAW_FLTT 13

# --- ATC 姿态控制参数 ---
ATC_ANG_PIT_P 5
ATC_ANG_RLL_P 5
ATC_ANG_YAW_P 4.5
ATC_ACCEL_P_MAX 60300
ATC_ACCEL_R_MAX 60300
ATC_ACCEL_Y_MAX 19800

# --- PSC 位置与高度 PID ---
PSC_POSXY_P 1.5
PSC_POSZ_P 1.0

PSC_VELXY_P 3.0
PSC_VELXY_I 1.0
PSC_VELXY_D 0.25
PSC_VELXY_IMAX 1000

PSC_VELZ_P 5.0

PSC_ACCZ_P 0.3
PSC_ACCZ_I 0.4
PSC_ACCZ_IMAX 800