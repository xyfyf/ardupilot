# hw definition file for processing by chibios_hwdef.py

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID AP_HW_EFT_CAAC

# unlock motors immediately after arming (no ARMING_DELAY_SEC wait)
define ARMING_DELAY_SEC 0

# default to all pins low to avoid ESD issues
DEFAULTGPIO OUTPUT LOW PULLDOWN

# Crystal is 16MHz
OSCILLATOR_HZ 16000000
STM32_ST_USE_TIMER 5

# Flash size 2MB
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 128
STORAGE_FLASH_PAGE 14

USB_STRING_MANUFACTURER "EFT_FC_T"
USB_STRING_PRODUCT "EFT_FC_T"

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# Debug / SWD
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# IMU
# BMI088 on SPI1
PA5  SPI1_SCK      SPI1
PA6  SPI1_MISO     SPI1
PA7  SPI1_MOSI     SPI1
PC4  BMI088_ACC_CS CS
PA4  BMI088_GYR_CS CS

# ICM42688 on SPI2
PD3  SPI2_SCK      SPI2
PB14 SPI2_MISO     SPI2
PC1  SPI2_MOSI     SPI2
PE12 ICM42688_CS   CS

# I2C Configuration
PB8 I2C1_SCL I2C1
PB9 I2C1_SDA I2C1
I2C_ORDER I2C1

# I2C1: Compass (QMC5883P) and Baro (SPL06)
COMPASS QMC5883P I2C:0:0x2C false ROTATION_ROLL_180
BARO SPL06 I2C:0:0x77

# CAN Buses CAN1:radar CAN2:motor
PD0 CAN1_RX CAN1
PD1 CAN1_TX CAN1
PB5 CAN2_RX CAN2
PB6 CAN2_TX CAN2

# Serial Order
# SERIAL0: USB
# SERIAL1: USART1 (GPS1)
# SERIAL2: UART4 (RSV2)
# SERIAL3: USART2 (RSV1)
# SERIAL4: USART3 (REMOTEID)
# SERIAL5: UART5 (ELRS)
# SERIAL6: UART8 (LINK)
# SERIAL7: UART7 (RTK)
SERIAL_ORDER OTG1 USART1 UART4 USART2 USART3 UART5 UART8 UART7

# GPS1 connector (used for LTE modem PPP)
PA9  USART1_TX USART1
PA10 USART1_RX USART1

# Telem1 (RSV1)
PA2 USART2_TX USART2 NODMA
PA3 USART2_RX USART2 NODMA

# Telem2 (RSV2)
PA0 UART4_TX UART4 NODMA
PA1 UART4_RX UART4 NODMA

# RemoteID
PD8 USART3_TX USART3 NODMA
PD9 USART3_RX USART3 NODMA

# ELRS
PB13 UART5_TX UART5 NODMA
PB12 UART5_RX UART5 NODMA

# LINK
PE1 UART8_TX UART8 NODMA
PE0 UART8_RX UART8 NODMA

# RTK (UM982 main GPS)
PE8 UART7_TX UART7 NODMA
PE7 UART7_RX UART7 NODMA

# SD Card
PC8  SDMMC1_D0  SDMMC1
PC9  SDMMC1_D1  SDMMC1
PC10 SDMMC1_D2  SDMMC1
PC11 SDMMC1_D3  SDMMC1
PC12 SDMMC1_CK  SDMMC1
PD2  SDMMC1_CMD SDMMC1

# Enable FAT filesystem for SD card support
define FATFS_HAL_DEVICE SDCD1
define HAL_OS_FATFS_IO 1

# PWM Output
# Output PWM1-PWM6 at 1000us/400Hz immediately after timer start.
define HAL_EARLY_PWM_1000_MASK 0x3F
define HAL_EARLY_PWM_FREQ_HZ 400

# Main (D1-D8)
PA8  TIM1_CH1 TIM1 PWM(1)  GPIO(50)
PB11 TIM2_CH4 TIM2 PWM(2)  GPIO(51)
PB10 TIM2_CH3 TIM2 PWM(3)  GPIO(52)
PE14 TIM1_CH4 TIM1 PWM(4)  GPIO(53)
PE13 TIM1_CH3 TIM1 PWM(5)  GPIO(54)
PE11 TIM1_CH2 TIM1 PWM(6)  GPIO(55)
PB1  TIM3_CH4 TIM3 PWM(7)  GPIO(56)
PB0  TIM3_CH3 TIM3 PWM(8)  GPIO(57)

# Aux (AUX1-AUX4)
PB4  TIM3_CH1 TIM3 PWM(9)  GPIO(58)
PB3  TIM2_CH2 TIM2 PWM(10) GPIO(59)
PD15 TIM4_CH4 TIM4 PWM(11) GPIO(60)
PD14 TIM4_CH3 TIM4 PWM(12) GPIO(61)

# RGB LED
PE6 LED_RED OUTPUT GPIO(90)
PE5 LED_GREEN OUTPUT GPIO(91)
PC5 LED_BLUE OUTPUT GPIO(92)
define AP_NOTIFY_GPIO_LED_RGB_RED_PIN 90
define AP_NOTIFY_GPIO_LED_RGB_GREEN_PIN 91
define AP_NOTIFY_GPIO_LED_RGB_BLUE_PIN 92
define HAL_LED_ON 1
define AP_NOTIFY_GPIO_LED_RGB_ENABLED 1

# WS2812B
PC6 TIM8_CH1 TIM8 PWM(13) GPIO(62)

# ADC (Battery)
PC0 BATT_VOLTAGE_SENS ADC1 SCALE(1)
define HAL_BATT_VOLT_PIN 10
define HAL_BATT_VOLT_SCALE 21.0
define HAL_BATT_CURR_PIN -1
define HAL_BATT_CURR_SCALE 17.0
define HAL_BATT_MONITOR_DEFAULT 3

# SPI Devices
SPIDEV bmi088_g SPI1 DEVID1 BMI088_GYR_CS MODE3 10*MHZ 10*MHZ
SPIDEV bmi088_a SPI1 DEVID2 BMI088_ACC_CS MODE3 10*MHZ 10*MHZ
SPIDEV icm42688 SPI2 DEVID3 ICM42688_CS   MODE3  2*MHZ  8*MHZ

# Sensors
IMU     BMI088       SPI:bmi088_a SPI:bmi088_g ROTATION_NONE
IMU     Invensensev3 SPI:icm42688              ROTATION_NONE

# Enable QMC5883L over u-blox GPS serial
define AP_COMPASS_UBLOX_GPS_ENABLED 1

# Enable OpenDroneID (Remote ID) support for drone identification and tracking
define AP_OPENDRONEID_ENABLED 1

# enable DFU reboot for installing bootloader
ENABLE_DFU_BOOT 1

# Enable FrSky SPort support
define AP_FRSKY_TELEM_ENABLED 1
define AP_FRSKY_SPORT_TELEM_ENABLED 1
define AP_FRSKY_SPORT_PASSTHROUGH_ENABLED 1

# Flash storage size
define HAL_STORAGE_SIZE 32768

# Enable PPP networking backend for LTE modem support
define AP_NETWORKING_BACKEND_PPP 1
DMA_NOSHARE SPI1* SPI2* USART1*